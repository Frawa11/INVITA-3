parents: "Juan Pérez & María Gómez",
    godparents: "Carlos López & Ana Torres",
        address: "Av. La Mar 123, Miraflores",
            backgroundUrl: "https://images.unsplash.com/photo-1519741497674-611481863552",
                galleryUrl1: "https://images.unsplash.com/photo-1566737236500-c8ac43014a67",
                    galleryUrl2: "https://images.unsplash.com/photo-1530103862676-de3c9da59af7",
                        musicUrl: "https://www.soundhelix.com/examples/mp3/SoundHelix-Song-1.mp3",
                            whatsappNumber: "+51999999999",
                                whatsappMessage: "Hola, confirmo mi asistencia a los 15 de Luciana."
    }
];

export default function AdminDashboard() {
    const [events, setEvents] = useState<EventData[]>(INITIAL_EVENTS);
    const [selectedEvent, setSelectedEvent] = useState<EventData | null>(null);
    const [isEditing, setIsEditing] = useState(false);

    const handleCreateNew = () => {
        setSelectedEvent(null);
        setIsEditing(true);
    };

    const handleEdit = (event: EventData) => {
        setSelectedEvent(event);
        setIsEditing(true);
    };

    const handleDelete = (id: number) => {
        if (confirm("¿Estás seguro de eliminar este evento?")) {
            setEvents(events.filter(e => e.id !== id));
            if (selectedEvent?.id === id) {
                setIsEditing(false);
                setSelectedEvent(null);
            }
        }
    };

    const handleSave = (data: EventData) => {
        if (selectedEvent) {
            // Update existing
            setEvents(events.map(e => e.id === selectedEvent.id ? { ...data, id: selectedEvent.id } : e));
        } else {
            // Create new
            const newEvent = { ...data, id: Date.now() };
            setEvents([...events, newEvent]);
        }
        setIsEditing(false);
        setSelectedEvent(null);
    };

    const handleShare = (event: EventData) => {
        // Generate WhatsApp Link
        const invitationUrl = `${window.location.origin}/invitation/${event.id}`;
        const message = `¡Hola! Te invito a mi evento *${event.type}* de *${event.celebrantName}*. Mira la invitación aquí: ${invitationUrl}`;
        const whatsappUrl = `https://wa.me/?text=${encodeURIComponent(message)}`;
        window.open(whatsappUrl, '_blank');
    };

    const handleLogout = async () => {
        await fetch("/api/auth/logout", { method: "POST" });
        window.location.href = "/login";
    };

    return (
        <div className="min-h-screen relative flex flex-col">
            <ParticleBackground />

            {/* Top Bar */}
            <header className="z-10 px-6 py-4 flex items-center justify-between border-b border-white/10 bg-white/5 backdrop-blur-md">
                <div className="flex items-center gap-4">
                    <div className="md:hidden">
                        <Menu className="text-white w-6 h-6" />
                    </div>
                    <h1 className="text-2xl font-bold text-white tracking-tight">Invita <span className="text-xs font-normal opacity-70 bg-white/10 px-2 py-1 rounded-full ml-2">Admin</span></h1>
                </div>

                <div className="flex items-center gap-6">
                    <nav className="hidden md:flex items-center gap-1 bg-white/10 rounded-full p-1">
                        <button className="px-4 py-1.5 rounded-full bg-white text-deep-violet font-medium text-sm shadow-sm">Bodas</button>
                        <button className="px-4 py-1.5 rounded-full text-white/80 hover:bg-white/10 font-medium text-sm transition-colors">15 Años</button>
                        <button className="px-4 py-1.5 rounded-full text-white/80 hover:bg-white/10 font-medium text-sm transition-colors">Bautizos</button>
                    </nav>

                    <div className="flex items-center gap-4 text-white/80">
                        <button
                            onClick={handleLogout}
                            className="text-sm font-medium text-white/80 hover:text-white transition-colors border border-white/20 px-3 py-1 rounded-full hover:bg-white/10"
                        >
                            Cerrar Sesión
                        </button>
                        <Bell className="w-5 h-5 hover:text-white cursor-pointer transition-colors" />
                        <div className="w-8 h-8 rounded-full bg-gradient-to-br from-electric-blue to-deep-violet border border-white/20 flex items-center justify-center">
                            <User className="w-4 h-4 text-white" />
                        </div>
                    </div>
                </div>
            </header>

            {/* Main Content */}
            <main className="flex-1 z-10 p-4 md:p-6 grid grid-cols-1 lg:grid-cols-12 gap-6 overflow-hidden h-[calc(100vh-73px)]">

                {/* Left Panel: Editor (Visible only when editing) */}
                <section className={`lg:col-span-7 flex flex-col h-full overflow-y-auto pb-20 lg:pb-0 transition-all duration-300 ${isEditing ? 'opacity-100 translate-x-0' : 'hidden lg:flex lg:opacity-50 lg:pointer-events-none'}`}>
                    <GlassPanel className="flex-1 flex flex-col">
                        {isEditing ? (
                            <EditorPanel
                                initialData={selectedEvent}
                                onSubmit={handleSave}
                                onCancel={() => setIsEditing(false)}
                            />
                        ) : (
                            <div className="flex-1 flex items-center justify-center text-gray-500 flex-col gap-4">
                                <Edit className="w-16 h-16 opacity-20" />
                                <p>Selecciona un evento para editar o crea uno nuevo</p>
                                <button
                                    onClick={handleCreateNew}
                                    className="px-6 py-2 bg-electric-blue text-white rounded-full font-medium shadow-lg hover:bg-deep-violet transition-colors pointer-events-auto"
                                >
                                    Crear Nuevo Evento
                                </button>
                            </div>
                        )}
                    </GlassPanel>
                </section>

                {/* Right Panel: Manager */}
                <section className={`${isEditing ? 'hidden lg:flex' : 'flex'} lg:col-span-5 flex-col h-full overflow-hidden`}>
                    <GlassPanel className="flex-1 flex flex-col overflow-hidden">
                        <div className="p-6 border-b border-gray-100 flex items-center justify-between bg-white/50">
                            <h2 className="text-xl font-semibold text-deep-violet">Mis Eventos</h2>
                            <button
                                onClick={handleCreateNew}
                                className="text-sm text-electric-blue font-medium hover:underline flex items-center gap-1"
                            >
                                <Plus className="w-4 h-4" /> Nuevo Evento
                            </button>
                        </div>

                        <div className="overflow-y-auto flex-1 p-0">
                            {/* Desktop Table */}
                            <table className="w-full text-left border-collapse hidden md:table">
                                <thead className="bg-gray-50/50 sticky top-0 backdrop-blur-sm">
                                    <tr>
                                        <th className="p-4 text-xs font-semibold text-gray-500 uppercase tracking-wider">Evento</th>
                                        <th className="p-4 text-xs font-semibold text-gray-500 uppercase tracking-wider">Fecha</th>
                                        <th className="p-4 text-xs font-semibold text-gray-500 uppercase tracking-wider text-right">Acciones</th>
                                    </tr>
                                </thead>
                                <tbody className="divide-y divide-gray-100">
                                    {events.map((event) => (
                                        <tr key={event.id} className={`hover:bg-blue-50/30 transition-colors group ${selectedEvent?.id === event.id ? 'bg-blue-50/50' : ''}`}>
                                            <td className="p-4">
                                                <div className="flex items-center gap-3">
                                                    <div className="w-8 h-8 rounded-full bg-gray-200 flex-shrink-0 overflow-hidden">
                                                        <div className="w-full h-full bg-gradient-to-br from-pink-300 to-purple-300"></div>
                                                    </div>
                                                        <p className="font-medium text-gray-800 text-sm">{event.type}</p>
                                                        <p className="text-xs text-gray-500">{event.celebrantName}</p>
                                                    </div>
                                                </div>
                                            </td>
                                            <td className="p-4 text-sm text-gray-600">
                                                {new Date(event.date).toLocaleDateString()}
                                            </td>
                                            <td className="p-4 text-right">
                                                <div className="flex items-center justify-end gap-2 opacity-60 group-hover:opacity-100 transition-opacity">
                                                    <button onClick={() => handleEdit(event)} className="p-2 hover:bg-blue-100 rounded-full text-blue-600 transition-colors" title="Editar">
                                                        <Edit className="w-4 h-4" />
                                                    </button>
                                                    <button onClick={() => window.open(`/invitation/${event.id}`, '_blank')} className="p-2 hover:bg-green-100 rounded-full text-green-600 transition-colors" title="Vista Previa">
                                                        <Eye className="w-4 h-4" />
                                                    </button>
                                                    <button onClick={() => alert("Función Agregar a Galería próximamente")} className="p-2 hover:bg-yellow-100 rounded-full text-yellow-600 transition-colors" title="Agregar a Galería">
                                                        <ImageIcon className="w-4 h-4" />
                                                    </button>
                                                    <button onClick={() => handleCopyLink(event)} className="p-2 hover:bg-purple-100 rounded-full text-purple-600 transition-colors" title="Copiar Enlace">
                                                        <LinkIcon className="w-4 h-4" />
                                                    </button>
                                                    <button onClick={() => handleDelete(event.id!)} className="p-2 hover:bg-red-100 rounded-full text-red-600 transition-colors" title="Eliminar">
                                                        <Trash2 className="w-4 h-4" />
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    ))}
                                {events.length === 0 && (
                                    <tr>
                                        <td colSpan={3} className="p-8 text-center text-gray-400">
                                            No tienes eventos creados.
                                        </td>
                                    </tr>
                                )}
                            </tbody>
                        </table>

                        {/* Mobile Cards */}
                        <div className="md:hidden p-4 space-y-4">
                            {events.map((event) => (
                                <div key={event.id} className="bg-white rounded-xl p-4 shadow-sm border border-gray-100 flex flex-col gap-3">
                                    <div className="flex items-center gap-3">
                                        <div className="w-12 h-12 rounded-full bg-gradient-to-br from-pink-300 to-purple-300 flex-shrink-0"></div>
                                        <div>
                                            <h3 className="font-semibold text-gray-800">{event.type}</h3>
                                            <p className="text-sm text-gray-600">{event.celebrantName}</p>
                                            <p className="text-xs text-gray-500">{new Date(event.date).toLocaleDateString()}</p>
                                        </div>
                                    </div>
                                    <div className="flex items-center justify-between pt-2 border-t border-gray-50">
                                        <div className="flex gap-1 ml-auto">
                                            <button onClick={() => handleEdit(event)} className="p-2 hover:bg-gray-100 rounded-full text-blue-600"><Edit className="w-4 h-4" /></button>
                                            <button onClick={() => handleShare(event)} className="p-2 hover:bg-gray-100 rounded-full text-purple-600"><Share2 className="w-4 h-4" /></button>
                                            <button onClick={() => handleDelete(event.id!)} className="p-2 hover:bg-gray-100 rounded-full text-red-600"><Trash2 className="w-4 h-4" /></button>
                                        </div>
                                    </div>
                                </div>
                            ))}
                        </div>

                    </div>
                </GlassPanel>
            </section>
        </main>
                    </div >
                    );
}
